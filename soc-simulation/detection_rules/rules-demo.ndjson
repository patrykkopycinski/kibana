{"id": "6ed498f4-722f-51ba-83f6-f9b91dce7561", "updated_at": "2026-04-15T00:00:00.000Z", "updated_by": "elastic", "created_at": "2026-04-15T00:00:00.000Z", "created_by": "elastic", "name": "[SOC-Sim] Shell Command Execution (T1059.004)", "tags": ["soc-simulation"], "interval": "1m", "enabled": true, "description": "Detects interactive shell execution or shell commands passed via -c flag. Maps to MITRE ATT&CK T1059.004 (Command and Scripting Interpreter: Unix Shell).", "risk_score": 47, "severity": "medium", "author": ["SOC Simulation"], "false_positives": ["Legitimate admin scripts", "Cron jobs"], "from": "now-120s", "rule_id": "soc-sim-shell-exec", "immutable": false, "max_signals": 100, "threat": [{"framework": "MITRE ATT&CK", "tactic": {"id": "TA0002", "name": "Execution", "reference": "https://attack.mitre.org/tactics/TA0002"}, "technique": [{"id": "T1059", "name": "Command and Scripting Interpreter", "reference": "https://attack.mitre.org/techniques/T1059", "subtechnique": [{"id": "T1059.004", "name": "Unix Shell", "reference": "https://attack.mitre.org/techniques/T1059/004"}]}]}], "type": "query", "language": "kuery", "query": "process.name:(\"bash\" or \"sh\" or \"zsh\" or \"dash\") and process.args:(\"-c\" or \"-i\" or \"--interactive\")", "index": ["logs-endpoint.events.process-*", "logs-system.auth-*"]}
{"id": "485782f7-66f6-5a78-9b3d-2f6b5065cf3a", "updated_at": "2026-04-15T00:00:00.000Z", "updated_by": "elastic", "created_at": "2026-04-15T00:00:00.000Z", "created_by": "elastic", "name": "[SOC-Sim] Crypto Mining Activity (T1496)", "tags": ["soc-simulation"], "interval": "1m", "enabled": true, "description": "Detects known cryptocurrency mining processes. Maps to MITRE ATT&CK T1496 (Resource Hijacking).", "risk_score": 73, "severity": "high", "author": ["SOC Simulation"], "false_positives": ["Authorized mining operations"], "from": "now-120s", "rule_id": "soc-sim-crypto-mining", "immutable": false, "max_signals": 100, "threat": [{"framework": "MITRE ATT&CK", "tactic": {"id": "TA0040", "name": "Impact", "reference": "https://attack.mitre.org/tactics/TA0040"}, "technique": [{"id": "T1496", "name": "Resource Hijacking", "reference": "https://attack.mitre.org/techniques/T1496"}]}], "type": "query", "language": "kuery", "query": "process.name:(\"xmrig\" or \"minerd\" or \"minergate\" or \"cpuminer\" or \"ethminer\") or process.command_line:(*stratum+tcp* or *pool.minexmr* or *crypto-pool*)", "index": ["logs-endpoint.events.process-*"]}
{"id": "6965ea1f-19d5-50eb-bf35-353405011769", "updated_at": "2026-04-15T00:00:00.000Z", "updated_by": "elastic", "created_at": "2026-04-15T00:00:00.000Z", "created_by": "elastic", "name": "[SOC-Sim] System Owner/User Discovery (T1033)", "tags": ["soc-simulation"], "interval": "1m", "enabled": true, "description": "Detects system reconnaissance commands commonly used by attackers to identify the current user and system. Maps to MITRE ATT&CK T1033.", "risk_score": 21, "severity": "low", "author": ["SOC Simulation"], "false_positives": ["System administration scripts", "Monitoring tools"], "from": "now-120s", "rule_id": "soc-sim-system-discovery", "immutable": false, "max_signals": 100, "threat": [{"framework": "MITRE ATT&CK", "tactic": {"id": "TA0007", "name": "Discovery", "reference": "https://attack.mitre.org/tactics/TA0007"}, "technique": [{"id": "T1033", "name": "System Owner/User Discovery", "reference": "https://attack.mitre.org/techniques/T1033"}]}], "type": "query", "language": "kuery", "query": "process.name:(\"whoami\" or \"id\" or \"hostname\" or \"uname\" or \"logname\")", "index": ["logs-endpoint.events.process-*"]}
{"id": "817b569a-7909-5e34-89d2-dec0db7730c6", "updated_at": "2026-04-15T00:00:00.000Z", "updated_by": "elastic", "created_at": "2026-04-15T00:00:00.000Z", "created_by": "elastic", "name": "[SOC-Sim] Suspicious Process from Temp Directory", "tags": ["soc-simulation"], "interval": "1m", "enabled": true, "description": "Detects process execution from temporary directories, often used by malware for staging. Generic catch-all rule.", "risk_score": 47, "severity": "medium", "author": ["SOC Simulation"], "false_positives": ["Package managers", "Build systems"], "from": "now-120s", "rule_id": "soc-sim-suspicious-process", "immutable": false, "max_signals": 100, "threat": [{"framework": "MITRE ATT&CK", "tactic": {"id": "TA0002", "name": "Execution", "reference": "https://attack.mitre.org/tactics/TA0002"}, "technique": [{"id": "T1204", "name": "User Execution", "reference": "https://attack.mitre.org/techniques/T1204"}]}], "type": "query", "language": "kuery", "query": "process.executable:(\"/tmp/*\" or \"/var/tmp/*\" or \"/dev/shm/*\")", "index": ["logs-endpoint.events.process-*"]}
{"id": "55df3781-bdcc-55c8-8aa6-d37485e1dcf7", "updated_at": "2026-04-15T00:00:00.000Z", "updated_by": "elastic", "created_at": "2026-04-15T00:00:00.000Z", "created_by": "elastic", "name": "[SOC-Sim] Lateral Movement via SSH/RDP (T1021)", "tags": ["soc-simulation"], "interval": "1m", "enabled": true, "description": "Detects outbound SSH or RDP connections to internal hosts, potential lateral movement. Maps to MITRE ATT&CK T1021.", "risk_score": 47, "severity": "medium", "author": ["SOC Simulation"], "false_positives": ["Legitimate SSH sessions between servers"], "from": "now-120s", "rule_id": "soc-sim-lateral-movement", "immutable": false, "max_signals": 100, "threat": [{"framework": "MITRE ATT&CK", "tactic": {"id": "TA0008", "name": "Lateral Movement", "reference": "https://attack.mitre.org/tactics/TA0008"}, "technique": [{"id": "T1021", "name": "Remote Services", "reference": "https://attack.mitre.org/techniques/T1021", "subtechnique": [{"id": "T1021.004", "name": "SSH", "reference": "https://attack.mitre.org/techniques/T1021/004"}]}]}], "type": "query", "language": "kuery", "query": "destination.port:(22 or 3389) and network.direction:\"outbound\" and destination.ip:(10.0.0.0/8 or 172.16.0.0/12 or 192.168.0.0/16)", "index": ["logs-endpoint.events.network-*"]}
{"id": "23b5a09e-5e42-5e97-9e57-8d532d17d90e", "updated_at": "2026-04-15T00:00:00.000Z", "updated_by": "elastic", "created_at": "2026-04-15T00:00:00.000Z", "created_by": "elastic", "name": "[SOC-Sim] Credential Dumping Attempt (T1003)", "tags": ["soc-simulation"], "interval": "1m", "enabled": true, "description": "Detects credential dumping tools or access to sensitive credential files. Maps to MITRE ATT&CK T1003.", "risk_score": 73, "severity": "high", "author": ["SOC Simulation"], "false_positives": ["Security scanning tools"], "from": "now-120s", "rule_id": "soc-sim-cred-dump", "immutable": false, "max_signals": 100, "threat": [{"framework": "MITRE ATT&CK", "tactic": {"id": "TA0006", "name": "Credential Access", "reference": "https://attack.mitre.org/tactics/TA0006"}, "technique": [{"id": "T1003", "name": "OS Credential Dumping", "reference": "https://attack.mitre.org/techniques/T1003"}]}], "type": "query", "language": "kuery", "query": "process.name:(\"mimikatz\" or \"gsecdump\" or \"hashdump\" or \"secretsdump\") or file.path:(\"/etc/shadow\" or \"/etc/passwd\") and event.action:\"open\"", "index": ["logs-endpoint.events.process-*", "logs-endpoint.events.file-*"]}
{"id": "9decb4ec-29d0-5903-b5b0-fc393d94aff6", "updated_at": "2026-04-15T00:00:00.000Z", "updated_by": "elastic", "created_at": "2026-04-15T00:00:00.000Z", "created_by": "elastic", "name": "[SOC-Sim] Persistence via Scheduled Task/Cron (T1053)", "tags": ["soc-simulation"], "interval": "1m", "enabled": true, "description": "Detects creation of scheduled tasks or cron jobs for persistence. Maps to MITRE ATT&CK T1053.003.", "risk_score": 47, "severity": "medium", "author": ["SOC Simulation"], "false_positives": ["Legitimate system cron jobs"], "from": "now-120s", "rule_id": "soc-sim-scheduled-task", "immutable": false, "max_signals": 100, "threat": [{"framework": "MITRE ATT&CK", "tactic": {"id": "TA0003", "name": "Persistence", "reference": "https://attack.mitre.org/tactics/TA0003"}, "technique": [{"id": "T1053", "name": "Scheduled Task/Job", "reference": "https://attack.mitre.org/techniques/T1053", "subtechnique": [{"id": "T1053.003", "name": "Cron", "reference": "https://attack.mitre.org/techniques/T1053/003"}]}]}], "type": "query", "language": "kuery", "query": "(process.name:\"crontab\" and process.args:(\"-e\" or \"-l\")) or file.path:(\"/etc/cron.d/*\" or \"/var/spool/cron/*\")", "index": ["logs-endpoint.events.process-*", "logs-endpoint.events.file-*"]}
