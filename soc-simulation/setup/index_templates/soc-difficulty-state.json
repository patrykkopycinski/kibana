{
  "index_patterns": [".soc-difficulty-state"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "soc-audit-permanent"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "level": { "type": "integer" },
        "level_name": { "type": "keyword" },
        "previous_level": { "type": "integer" },
        "decision": { "type": "keyword" },
        "reasoning": { "type": "text" }
      }
    }
  }
}
