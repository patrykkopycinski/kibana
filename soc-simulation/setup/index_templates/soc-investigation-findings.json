{
  "index_patterns": [".soc-investigation-findings"],
  "data_stream": {},
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "soc-default"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "source": { "type": "keyword" },
        "stage": { "type": "keyword" },
        "investigation_output": { "type": "text" }
      }
    }
  }
}
