{
  "index_patterns": [".soc-hunt-findings"],
  "data_stream": {},
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "soc-default"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "source": { "type": "keyword" },
        "hunt_output": { "type": "text" },
        "hunt_type": { "type": "keyword" },
        "findings_count": { "type": "integer" },
        "techniques_hunted": { "type": "keyword" },
        "status": { "type": "keyword" }
      }
    }
  }
}
