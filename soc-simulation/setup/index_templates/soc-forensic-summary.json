{
  "index_patterns": [".soc-forensic-summary"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "case_id":   { "type": "keyword" },
        "closed_at": { "type": "date" },
        "verdict":   { "type": "keyword" },
        "iocs": {
          "type": "nested",
          "properties": {
            "type":       { "type": "keyword" },
            "value":      { "type": "keyword", "ignore_above": 1024 },
            "confidence": { "type": "float" }
          }
        },
        "yara_rules": {
          "type": "nested",
          "properties": {
            "name":                 { "type": "keyword" },
            "body":                 { "type": "text" },
            "added_to_rules_index": { "type": "boolean" }
          }
        },
        "attribution": {
          "properties": {
            "actor":    { "type": "keyword" },
            "campaign": { "type": "keyword" },
            "ttps":     { "type": "keyword" }
          }
        },
        "exceptions_created": {
          "type": "nested",
          "properties": {
            "rule_id":      { "type": "keyword" },
            "exception_id": { "type": "keyword" }
          }
        },
        "summary_markdown": { "type": "text" }
      }
    }
  }
}
