{
  "index_patterns": [".soc-agent-health"],
  "data_stream": {},
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "soc-default"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "agent_id": { "type": "keyword" },
        "throughput": { "type": "float" },
        "latency_p50": { "type": "float" },
        "latency_p95": { "type": "float" },
        "error_rate": { "type": "float" },
        "status": { "type": "keyword" }
      }
    }
  }
}
