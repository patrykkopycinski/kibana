{
  "index_patterns": [".soc-connector-health"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "soc-default"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "connector_id": { "type": "keyword" },
        "connector_name": { "type": "keyword" },
        "status": { "type": "keyword" },
        "latency_ms": { "type": "long" },
        "error_message": { "type": "text" },
        "consecutive_failures": { "type": "integer" },
        "fallback_connector_id": { "type": "keyword" }
      }
    }
  }
}
