{
  "index_patterns": [".soc-skill-recommendations"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "soc-default"
    },
    "mappings": {
      "properties": {
        "@timestamp":            { "type": "date" },
        "skill_id":              { "type": "keyword" },
        "verdict":               { "type": "keyword" },
        "reasons":               { "type": "keyword" },
        "recommended_actions":   { "type": "keyword" },
        "metrics_snapshot": {
          "properties": {
            "invocations_7d":      { "type": "integer" },
            "success_count_7d":    { "type": "integer" },
            "failure_count_7d":    { "type": "integer" },
            "success_rate_7d":     { "type": "float" },
            "last_run_ts":         { "type": "date" }
          }
        },
        "thresholds_applied": {
          "properties": {
            "min_invocations_for_verdict":   { "type": "integer" },
            "success_rate_floor_demote":     { "type": "float" },
            "success_rate_floor_review":     { "type": "float" },
            "min_invocations_for_reprompt":  { "type": "integer" }
          }
        },
        "generated_by":          { "type": "keyword" },
        "generated_at":          { "type": "date" },
        "schema_version":        { "type": "integer" }
      }
    }
  },
  "_meta": {
    "description": "AutoDEX B9 — self-adjusting skills loop. Each row records a single skill-health verdict produced by the soc_skill_self_adjust workflow from the latest .soc-skill-metrics snapshot. The verdict is one of healthy / review / reprompt / demote / insufficient_data. The verdict logic is mirrored 1:1 in evaluateSkillHealth (kbn-argus-tool-manifest/skill_health.ts) so MCP-side gates and the YAML workflow stay aligned.",
    "owner": "argus-governance",
    "schema_version": 1,
    "verdicts": ["healthy", "review", "reprompt", "demote", "insufficient_data"],
    "actions": ["log_only", "open_review_case", "reprompt_skill", "demote_actor", "freeze_skill"]
  }
}
