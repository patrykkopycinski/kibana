{
  "index_patterns": [".soc-recommendations"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.default_pipeline": "soc-mutation-intent-envelope-validator",
      "index.final_pipeline": "_none"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "rec_id": { "type": "keyword" },
        "type": { "type": "keyword" },
        "source": { "type": "keyword" },
        "source_doc_id": { "type": "keyword" },
        "status": { "type": "keyword" },
        "title": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
        "summary": { "type": "text" },
        "details": { "type": "object", "enabled": false },
        "reasoning": { "type": "text" },
        "confidence": { "type": "integer" },
        "reviewed_by": { "type": "keyword" },
        "reviewed_at": { "type": "date" },
        "review_decision": { "type": "keyword" },
        "rejection_reason": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
        "trust_gate_decision": { "type": "keyword" },
        "trust_gate_tier": { "type": "keyword" },
        "trust_gate_door_class": { "type": "keyword" },
        "trust_gate_checked_at": { "type": "date" },
        "trust_gate_tick": { "type": "keyword" },
        "argus": {
          "properties": {
            "origin": { "type": "keyword" },
            "decision": {
              "properties": {
                "kind": { "type": "keyword" },
                "confidence": { "type": "float" },
                "door_class": { "type": "keyword" }
              }
            },
            "agent": {
              "properties": {
                "id": { "type": "keyword" },
                "version": { "type": "keyword" }
              }
            },
            "actor": {
              "properties": {
                "trust_tier": { "type": "keyword" }
              }
            },
            "corpus": {
              "properties": {
                "id": { "type": "keyword" },
                "expected_rule_id": { "type": "keyword" }
              }
            }
          }
        },
        "applied_at": { "type": "date" },
        "apply_error": { "type": "text" },
        "sub_items": { "type": "object", "enabled": false },
        "track": { "type": "keyword" },
        "housekeeping": { "type": "boolean" },
        "expected_impact": {
          "properties": {
            "fp_reduction_pct": { "type": "float" },
            "tp_gain_pct": { "type": "float" },
            "mttr_reduction_minutes": { "type": "float" },
            "hours_saved_per_week": { "type": "float" },
            "coverage_delta_pct": { "type": "float" },
            "blast_tier": { "type": "keyword" },
            "blast_radius": {
              "properties": {
                "hosts":   { "type": "integer" },
                "tenants": { "type": "integer" },
                "rules":   { "type": "integer" }
              }
            }
          }
        },
        "trust_gate_blast_tier": { "type": "keyword" },
        "evidence": {
          "type": "nested",
          "properties": {
            "summary": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
            "source_ref": { "type": "keyword", "ignore_above": 2048 },
            "confidence": { "type": "float" }
          }
        }
      }
    }
  }
}
