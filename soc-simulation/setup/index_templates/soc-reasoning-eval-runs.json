{
  "index_patterns": [".soc-reasoning-eval-runs"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "soc-audit-permanent"
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp":        { "type": "date" },
        "run_id":            { "type": "keyword" },
        "suite_id":          { "type": "keyword" },
        "trace_run_id":      { "type": "keyword" },
        "traces_index":      { "type": "keyword" },
        "spans_evaluated":   { "type": "integer" },
        "gate_decision":     { "type": "keyword" },
        "aggregate": {
          "properties": {
            "mean": {
              "properties": {
                "evidence":    { "type": "float" },
                "calibration": { "type": "float" },
                "coherence":   { "type": "float" },
                "safety":      { "type": "float" }
              }
            },
            "p5": {
              "properties": {
                "evidence":    { "type": "float" },
                "calibration": { "type": "float" },
                "coherence":   { "type": "float" },
                "safety":      { "type": "float" }
              }
            },
            "spans_evaluated": { "type": "integer" }
          }
        },
        "thresholds": {
          "properties": {
            "min_mean_evidence":    { "type": "float" },
            "min_mean_calibration": { "type": "float" },
            "min_mean_coherence":   { "type": "float" },
            "min_mean_safety":      { "type": "float" },
            "min_p5_safety":        { "type": "float" },
            "marginal_band":        { "type": "float" },
            "min_mean_injection_detected": { "type": "float" },
            "min_mean_refusal_rate":       { "type": "float" },
            "min_mean_scope_adherence":    { "type": "float" },
            "min_min_no_secret_leakage":   { "type": "float" }
          }
        },
        "suite_kind":     { "type": "keyword" },
        "corpus_version": { "type": "keyword" },
        "cases_evaluated": { "type": "integer" },
        "per_case": {
          "type": "nested",
          "properties": {
            "id":     { "type": "keyword" },
            "family": { "type": "keyword" },
            "score": {
              "properties": {
                "injection_detected": { "type": "float" },
                "refusal_rate":       { "type": "float" },
                "scope_adherence":    { "type": "float" },
                "no_secret_leakage":  { "type": "float" }
              }
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Argus R11+R2 \u2014 Reasoning and Adversarial Eval Vertical runs. Each doc is one evaluation pass, distinguished by suite_kind: 'reasoning' rows score .soc-reasoning-trace spans against the reasoning rubric (evidence / calibration / coherence / safety), 'adversarial' rows score an Argus actor against the prompt-injection corpus (injection_detected / refusal_rate / scope_adherence / no_secret_leakage). Both share the same gate_decision vocabulary (pass | marginal | fail) and are consumed by soc-argus-trust-tier-assessor to push actors toward probationary/quarantined when their reasoning drifts or adversarial robustness regresses. Emitted by @kbn/evals-suite-argus-reasoning (Playwright suites or the CLI twins run_reasoning_eval.ts / run_adversarial_eval.ts).",
    "owner": "argus-governance",
    "schema_version": 2
  }
}
