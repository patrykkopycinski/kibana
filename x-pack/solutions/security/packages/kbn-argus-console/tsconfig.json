{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node",
      "react",
      "@testing-library/jest-dom",
      "@testing-library/react",
      "@kbn/ambient-ui-types"
    ]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "kbn_references": [
    "@kbn/argus-console-common",
    "@kbn/argus-reasoning-traces",
    "@kbn/core",
    "@kbn/core-http-browser",
    "@kbn/i18n",
    "@kbn/i18n-react"
  ],
  "exclude": ["target/**/*"]
}
