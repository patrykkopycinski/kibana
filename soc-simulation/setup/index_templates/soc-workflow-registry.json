{
  "index_patterns": [".soc-workflow-registry"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "workflow_id":         { "type": "keyword" },
        "automation_level":    { "type": "keyword" },
        "connectors":          { "type": "keyword" },
        "summary":             { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
        "owner":               { "type": "keyword" },
        "model_tier":          { "type": "keyword" },
        "tags":                { "type": "keyword" },
        "kibana_workflow_id":  { "type": "keyword" },
        "last_seeded_at":      { "type": "date" }
      }
    }
  }
}
