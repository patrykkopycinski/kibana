{
  "index_patterns": [".soc-detection-eval-runs"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "soc-audit-permanent"
    },
    "mappings": {
      "properties": {
        "@timestamp":              { "type": "date" },
        "run_id":                  { "type": "keyword" },
        "suite_id":                { "type": "keyword" },
        "rule_id":                 { "type": "keyword" },
        "rule_version":            { "type": "keyword" },
        "rule_snapshot":           { "type": "object", "enabled": false },
        "corpus_id":               { "type": "keyword" },
        "snapshot_id":             { "type": "keyword" },
        "executor":                { "type": "keyword" },

        "scores": {
          "properties": {
            "precision":           { "type": "float" },
            "recall":              { "type": "float" },
            "fp_rate_baseline":    { "type": "float" },
            "variant_coverage":    { "type": "float" }
          }
        },

        "counts": {
          "properties": {
            "corpus_total":        { "type": "long" },
            "corpus_positives":    { "type": "long" },
            "corpus_negatives":    { "type": "long" },
            "baseline_total":      { "type": "long" },
            "true_positives":      { "type": "long" },
            "false_positives":     { "type": "long" },
            "false_negatives":     { "type": "long" },
            "true_negatives":      { "type": "long" }
          }
        },

        "variants": {
          "properties": {
            "total":               { "type": "long" },
            "covered":             { "type": "long" },
            "missed":              { "type": "keyword" }
          }
        },

        "gate_decision":           { "type": "keyword" },
        "gate_reason":             { "type": "text" },
        "adversarial_input_ids":   { "type": "keyword" },

        "source_recommendation_id":{ "type": "keyword" },
        "compute_duration_ms":     { "type": "long" }
      }
    }
  },
  "_meta": {
    "description": "Argus M2.1 — one row per detection-rule candidate per eval run, emitted by the @kbn/evals-suite-argus-detection Playwright suite. Consumed by soc-detection-eval (poller) and soc-regression-gate.",
    "owner": "argus-governance",
    "schema_version": 1,
    "gate_decisions": ["pass", "fail", "marginal"]
  }
}
