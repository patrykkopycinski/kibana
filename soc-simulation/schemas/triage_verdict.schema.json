{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schemas/triage_verdict.schema.json",
  "title": "Triage Verdict",
  "type": "object",
  "required": ["details"],
  "properties": {
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alert_id", "rule_id", "disposition", "confidence", "next_step", "techniques", "indicators_checked"],
      "properties": {
        "alert_id": { "type": "string", "minLength": 1 },
        "alert_fingerprint": { "type": ["string", "null"] },
        "rule_id": { "type": "string", "minLength": 1 },
        "rule_name": { "type": ["string", "null"] },
        "disposition": {
          "type": "string",
          "enum": [
            "true_positive_high",
            "true_positive_low",
            "benign_positive",
            "suspicious_needs_hunt",
            "duplicate_of_case",
            "auto_closed_fp",
            "unknown"
          ],
          "description": "Richer than binary TP/FP. 'benign_positive' = rule fired correctly but behavior is authorized. 'duplicate_of_case' = same incident already triaged."
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "threat_category": {
          "type": "string",
          "enum": ["malware", "credential_theft", "lateral_movement", "data_exfiltration", "persistence", "reconnaissance", "privilege_escalation", "defense_evasion", "none"]
        },
        "kill_chain_stage": {
          "type": "string",
          "enum": ["reconnaissance", "weaponization", "delivery", "exploitation", "installation", "command_and_control", "actions_on_objectives", "n/a"]
        },
        "business_impact": { "type": "string", "enum": ["critical", "high", "medium", "low", "none"] },
        "techniques": {
          "type": "array",
          "items": { "type": "string", "pattern": "^T\\d{4}(\\.\\d{3})?$" },
          "description": "MITRE ATT&CK technique IDs, e.g. T1059.001"
        },
        "indicators_checked": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evidence sources the agent examined. Minimum 2."
        },
        "next_step": {
          "type": "string",
          "enum": ["escalate_to_case", "enrich_then_recheck", "open_hunt", "auto_close_fp", "wait_for_more_signal"]
        },
        "duplicate_of_case_id": { "type": ["string", "null"] }
      }
    }
  }
}
