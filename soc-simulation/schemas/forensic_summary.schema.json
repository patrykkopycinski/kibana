{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosoc.local/schemas/forensic_summary.schema.json",
  "title": "AutoSOC Case Forensic Summary",
  "description": "Durable snapshot of forensic artifacts captured at case close. One doc per case_id, created via op_type=create.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "closed_at", "verdict", "summary_markdown"],
  "properties": {
    "case_id":   { "type": "string", "minLength": 1 },
    "closed_at": { "type": "string", "format": "date-time" },
    "verdict": {
      "type": "string",
      "enum": ["true_positive", "false_positive", "benign_true_positive", "inconclusive"]
    },
    "iocs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type":       { "type": "string", "enum": ["ipv4", "ipv6", "domain", "url", "sha256", "sha1", "md5", "email", "file_path", "process_name", "user", "host"] },
          "value":      { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "yara_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "body"],
        "properties": {
          "name":                  { "type": "string", "minLength": 1 },
          "body":                  { "type": "string", "minLength": 1 },
          "added_to_rules_index":  { "type": "boolean" }
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor":    { "type": ["string", "null"] },
        "campaign": { "type": ["string", "null"] },
        "ttps":     { "type": "array", "items": { "type": "string" } }
      }
    },
    "exceptions_created": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "exception_id"],
        "properties": {
          "rule_id":      { "type": "string" },
          "exception_id": { "type": "string" }
        }
      }
    },
    "summary_markdown": { "type": "string", "minLength": 1 }
  }
}
