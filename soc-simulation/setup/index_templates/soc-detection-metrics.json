{
  "index_patterns": [".soc-detection-metrics"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "soc-default"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "attack_id": { "type": "keyword" },
        "technique_id": { "type": "keyword" },
        "attack_started_at": { "type": "date" },
        "detection_fired_at": { "type": "date" },
        "triage_completed_at": { "type": "date" },
        "time_to_detect_ms": { "type": "long" },
        "time_to_triage_ms": { "type": "long" },
        "detection_rule_id": { "type": "keyword" },
        "triage_classification": { "type": "keyword" },
        "triage_confidence": { "type": "float" },
        "triage_correct": { "type": "boolean" },
        "status": { "type": "keyword" }
      }
    }
  }
}
