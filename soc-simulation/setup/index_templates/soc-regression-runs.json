{
  "index_patterns": [".soc-regression-runs"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "run_id": { "type": "keyword" },
        "trigger": { "type": "keyword" },
        "candidate_artifact_ref": { "type": "keyword" },
        "candidate_definition_hash": { "type": "keyword" },
        "baseline_artifact_ref": { "type": "keyword" },
        "baseline_definition_hash": { "type": "keyword" },
        "dataset_size": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "regressions": { "type": "integer" },
        "regression_delta": { "type": "float" },
        "gate_result": { "type": "keyword" },
        "gate_reason": { "type": "text" },
        "per_case": { "type": "object", "enabled": false }
      }
    }
  },
  "_meta": {
    "description": "Per-run results of the regression gate. gate_result = pass|fail|skipped. Blocks the triggering autonomous mutation when gate_result=fail.",
    "owner": "argus-governance",
    "schema_version": 1
  }
}
