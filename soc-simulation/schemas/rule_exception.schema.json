{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schemas/rule_exception.schema.json",
  "title": "Rule Exception",
  "description": "Add / update / delete an entry on a detection rule's exception list. Authored by the Signal Quality agent (not the Principal DetEng agent).",
  "type": "object",
  "required": ["details"],
  "properties": {
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "op", "exception_list_id", "entries", "scope_justification"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "op": { "type": "string", "enum": ["add", "update", "delete"] },
        "exception_list_id": { "type": ["string", "null"] },
        "existing_exception_item_id": { "type": ["string", "null"] },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "type", "operator", "value"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "enum": ["match", "match_any", "wildcard", "exists", "nested"] },
              "operator": { "type": "string", "enum": ["included", "excluded"] },
              "value": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }
            }
          }
        },
        "scope_justification": {
          "type": "string",
          "minLength": 20,
          "description": "Human-readable explanation of WHY this exception is safe (e.g. 'patch tuesday scanner from known-good host 10.1.1.42')."
        },
        "false_positive_cases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Case IDs that triggered this exception."
        },
        "sample_size": { "type": "integer", "minimum": 1 },
        "detection_guard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["known_tp_cases_unaffected", "method"],
          "properties": {
            "known_tp_cases_unaffected": { "type": "boolean" },
            "method": { "type": "string", "description": "How the agent verified known TPs still trigger under this exception." }
          }
        }
      }
    }
  }
}
